<mujoco model="rh56e2_right_standalone">
  <!-- Fixed-base right RH56E2 test scene. Kept structurally identical to
       rh56e2_left_standalone.xml so both hands use the same cylinder and
       compliant, mocap-driven fine probe validation workflow. -->
  <compiler angle="radian"/>

  <asset>
    <texture name="groundplane" type="2d" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <model name="rh56e2_right" file="rh56e2_right.xml"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" type="directional"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" pos="0 0 -0.1"/>

    <!-- Right geometry is mirrored from left in its asset frame. Using the
         left mount quaternion mapped that mirror axis into world vertical,
         putting the right thumb below the palm. This +90deg-X mount keeps
         the fingers pointing in the same world direction as the left test
         scene while putting the thumb upright on the opposite side. -->
    <body name="r_rh_mount" pos="0 0 0.3" quat="0.707107 0.707107 0 0">
      <attach model="rh56e2_right" body="flange" prefix="r_rh_"/>
    </body>

    <body name="test_cylinder" pos="0.05 -0.14 0.3" quat="0 0 -0.707107 0.707107" gravcomp="1">
      <freejoint/>
      <geom name="test_cylinder" type="cylinder" fromto="0 -0.045 0 0 0.035 0" size="0.03"
        rgba="0.9 0.3 0.1 1" friction="1.0 0.005 0.0001"/>
    </body>

    <body name="test_probe_target" mocap="true" pos="-0.05 -0.14 0.3"/>
    <body name="test_probe" pos="-0.05 -0.14 0.3" gravcomp="1">
      <freejoint/>
      <geom name="test_probe" type="sphere" size="0.004" mass="0.05"
        rgba="0.2 0.6 0.9 1" friction="1.0 0.005 0.0001"/>
    </body>
  </worldbody>

  <equality>
    <weld name="test_probe_driver" body1="test_probe_target" body2="test_probe"
      solref="0.03 1" solimp="0.9 0.95 0.001"/>
  </equality>
</mujoco>
