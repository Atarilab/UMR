<mujoco model="rh56e2_right">
  <!-- Inspire RH56E2 right hand, generated from
       rh56e2_urdf/urdf/rh56e2_right.urdf (SolidWorks export "RH56E2_R_2025_9_11").
       Link frames, joint axes, limits, mimic ratios and link inertias are the
       URDF's; the tactile pads, collision proxies and drive limits are added
       here.  URDF names are kept except "little" -> "pinky", which is what the
       rest of this repo (rh56e2_hands.py, rh56e2_sysid.py) already calls it.

       Frames: the URDF root link is the wrist adapter, with -z pointing down
       the hand.  "flange" re-exposes it with +z down the hand, which is the
       frame the future G1 assembly should mount against, matching the
       previous hand model convention.  That adapter is the part those models drew
       as a separate ft_sensor mesh; here it is base_link, so it is not drawn
       twice. -->
  <compiler angle="radian" meshdir="meshes/inspire_rh56e2"/>

  <default>
    <default class="finger_motor">
      <joint damping="0.02" armature="0.005" frictionloss="0.05"/>
    </default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
    </default>
    <default class="collision">
      <geom type="mesh" group="3" rgba="0.4 0.5 0.9 0.3"/>
    </default>
    <default class="pad">
      <site type="box" group="4" rgba="0.9 0.3 0.1 0.35"/>
    </default>
  </default>

  <asset>
    <material name="shell" rgba="0.85 0.85 0.85 1" specular="0.6" shininess="0.5"/>
    <material name="body" rgba="0.25 0.25 0.25 1" specular="0.25" shininess="0.25"/>
    <!-- the pads are the same rubber as the fingers -->
