  </worldbody>

  <!-- thumb_2 pivots inside a cradle moulded into the palm, so its collision
       proxy and the palm's overlap at every thumb angle.  hand_base is
       thumb_2's grandparent, so MuJoCo's parent/child filter misses it.
       Palm contact still works through thumb_3 / thumb_4.

       The finger roots are the palm's own children, so the parent filter
       normally covers them, but it exempts bodies welded to the world,
       which is what the palm becomes when this model is loaded on its own.
       Listing them keeps the standalone model usable; in an arm they were
       filtered anyway. -->
  <contact>
    <exclude body1="right_hand_base" body2="right_thumb_2"/>
    <exclude body1="right_hand_base" body2="right_thumb_1"/>
    <exclude body1="right_hand_base" body2="right_index_1"/>
    <exclude body1="right_hand_base" body2="right_middle_1"/>
    <exclude body1="right_hand_base" body2="right_ring_1"/>
    <exclude body1="right_hand_base" body2="right_pinky_1"/>
  </contact>

  <!-- URDF <mimic>: the coupled joint is joint1 here, because MuJoCo solves
       joint1 = polycoef(joint2).  Their ranges are the driving joint's range
       times the ratio, not the URDF's own (slightly tighter) limits, so a
       fully closed finger does not fight its own limit. -->
  <equality>
    <joint joint1="right_thumb_joint3" joint2="right_thumb_joint2" polycoef="0 0.8392 0 0 0"
      solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <joint joint1="right_thumb_joint4" joint2="right_thumb_joint3" polycoef="0 0.891 0 0 0"
      solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <joint joint1="right_index_dip" joint2="right_index_joint" polycoef="0 1.0843 0 0 0"
      solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <joint joint1="right_middle_dip" joint2="right_middle_joint" polycoef="0 1.0843 0 0 0"
      solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <joint joint1="right_ring_dip" joint2="right_ring_joint" polycoef="0 1.0843 0 0 0"
      solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <joint joint1="right_pinky_dip" joint2="right_pinky_joint" polycoef="0 1.0843 0 0 0"
      solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </equality>

  <!-- Torque motors, gear 1, so ctrl is in Nm.  Limits are the datasheet
       tip force times each drive's lever arm at full extension. -->
  <actuator>
    <motor name="thumb_rot"   joint="right_thumb_joint1"   ctrlrange="-3.35 3.35"/>
    <motor name="thumb_flex"  joint="right_thumb_joint2"   ctrlrange="-3 3"/>
    <motor name="index"       joint="right_index_joint"    ctrlrange="-2.44 2.44"/>
    <motor name="middle"      joint="right_middle_joint"   ctrlrange="-2.55 2.55"/>
    <motor name="ring"        joint="right_ring_joint"     ctrlrange="-2.44 2.44"/>
    <motor name="pinky"       joint="right_pinky_joint"    ctrlrange="-2.17 2.17"/>
  </actuator>

  <sensor>
    <jointpos name="thumb_rot_pos" joint="right_thumb_joint1"/>
    <jointpos name="thumb_flex_pos" joint="right_thumb_joint2"/>
    <jointpos name="index_pos" joint="right_index_joint"/>
    <jointpos name="middle_pos" joint="right_middle_joint"/>
    <jointpos name="ring_pos" joint="right_ring_joint"/>
    <jointpos name="pinky_pos" joint="right_pinky_joint"/>

    <jointvel name="thumb_rot_vel" joint="right_thumb_joint1"/>
    <jointvel name="thumb_flex_vel" joint="right_thumb_joint2"/>
    <jointvel name="index_vel" joint="right_index_joint"/>
    <jointvel name="middle_vel" joint="right_middle_joint"/>
    <jointvel name="ring_vel" joint="right_ring_joint"/>
    <jointvel name="pinky_vel" joint="right_pinky_joint"/>

    <jointactuatorfrc name="thumb_rot_torque" joint="right_thumb_joint1"/>
    <jointactuatorfrc name="thumb_flex_torque" joint="right_thumb_joint2"/>
    <jointactuatorfrc name="index_torque" joint="right_index_joint"/>
    <jointactuatorfrc name="middle_torque" joint="right_middle_joint"/>
    <jointactuatorfrc name="ring_torque" joint="right_ring_joint"/>
    <jointactuatorfrc name="pinky_torque" joint="right_pinky_joint"/>

    <!-- Tactile pads: 17 per hand, one <touch> scalar (sum of contact normal
         force at the site, newtons) per real pad. 30 N full scale, accuracy
         <=5% FS. Each site is the bounding box of that pad's mesh in the
         URDF, grown to 8mm thick so a contact on the finger surface above
         the pad falls inside it. noise is recorded for the user; the engine
         does not inject it.

         These are NOT what drives rt/inspire_hand/touch/{l,r} anymore --
         hand_bridge.py computes real per-cell taxel grids itself by reading
         mj_data.contact directly each publish and rasterizing each
         contact's normal force onto nearby taxels in the corresponding
         pad's local frame (Gaussian-kernel spread, not a rigid per-cell
         collision geom), using these same site pos/quat as the pad frame
         reference. Kept here as a coarse, independent cross-check value
         (sum-of-rasterized-taxels should roughly track this) and because
         collision geometry stays exactly what it always was -- no touch
         model should ever perturb real contact dynamics.

         Two things this replaced, and why: mujoco.sensor.touch_grid (a
         plugin) needs ~20-25mm of clearance between its site and the
         contact point before it reports anything nonzero (confirmed
         empirically), and every pad here has under ~5.5mm of physical
         clearance before hitting some other part of the hand -- see
         https://github.com/google-deepmind/mujoco/discussions/2269 for the
         same unresolved question from another user. A later attempt tiled
         real tiny collision geoms per taxel (proven to give genuine spatial
         resolution) but was abandoned in favor of the current
         contact-rasterization approach: tiling collision geometry
         double-counts force against these same coarse sensors' proxies and
         adds real solve cost (measured ~31x -> ~3.3x realtime factor on the
         full body), whereas rasterizing from unmodified contacts has
         neither problem and gives a smoother, more sensor-realistic spread
         besides.

         Site-to-pad assignment is verified against both the RH56DFTP
         manual's diagram and this asset's body nesting: base-to-tip is
         pad -> nail -> tip. Thus force_sensor_1 on each plain finger's
         proximal body maps to palm_touch (10x8), while force_sensor_2 and
         _3 on its distal body map to top/nail_touch (12x8) and tip_touch
         (3x3). The thumb follows the same base-to-tip convention with its
         additional middle_touch pad between base and nail. -->
    <touch name="fingerone_palm_touch" site="pinky_force_sensor_1" cutoff="30" noise="1.5"/>
    <touch name="fingerone_top_touch" site="pinky_force_sensor_2" cutoff="30" noise="1.5"/>
    <touch name="fingerone_tip_touch" site="pinky_force_sensor_3" cutoff="30" noise="1.5"/>

    <touch name="fingertwo_palm_touch" site="ring_force_sensor_1" cutoff="30" noise="1.5"/>
    <touch name="fingertwo_top_touch" site="ring_force_sensor_2" cutoff="30" noise="1.5"/>
    <touch name="fingertwo_tip_touch" site="ring_force_sensor_3" cutoff="30" noise="1.5"/>

    <touch name="fingerthree_palm_touch" site="middle_force_sensor_1" cutoff="30" noise="1.5"/>
    <touch name="fingerthree_top_touch" site="middle_force_sensor_2" cutoff="30" noise="1.5"/>
    <touch name="fingerthree_tip_touch" site="middle_force_sensor_3" cutoff="30" noise="1.5"/>

    <touch name="fingerfour_palm_touch" site="index_force_sensor_1" cutoff="30" noise="1.5"/>
    <touch name="fingerfour_top_touch" site="index_force_sensor_2" cutoff="30" noise="1.5"/>
    <touch name="fingerfour_tip_touch" site="index_force_sensor_3" cutoff="30" noise="1.5"/>

    <touch name="fingerfive_palm_touch" site="thumb_force_sensor_1" cutoff="30" noise="1.5"/>
    <touch name="fingerfive_middle_touch" site="thumb_force_sensor_2" cutoff="30" noise="1.5"/>
    <touch name="fingerfive_top_touch" site="thumb_force_sensor_3" cutoff="30" noise="1.5"/>
    <touch name="fingerfive_tip_touch" site="thumb_force_sensor_4" cutoff="30" noise="1.5"/>

    <touch name="palm_touch" site="palm_force_sensor" cutoff="30" noise="1.5"/>
  </sensor>
</mujoco>
