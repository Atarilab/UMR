          <geom class="visual" material="pad" mesh="pinky_force_sensor_1" pos="0.012046 0.019649 0.006651" quat="0.706132317 -0.112374478 0.698120457 0.0371073371"/>
          <geom class="collision" mesh="proximal_col0"/>
          <geom class="collision" mesh="proximal_col1"/>
          <geom class="collision" mesh="proximal_col2"/>
          <geom class="collision" mesh="proximal_col3"/>
          <geom class="collision" mesh="proximal_col4"/>
          <geom class="collision" mesh="proximal_col5"/>
          <site name="pinky_force_sensor_1" class="pad" pos="0.0116528 0.0196359 0.00665085" quat="0.706132317 -0.112374478 0.698120457 0.0371073371" size="0.0061671 0.00768 0.004"/>
          <body name="right_pinky_2" pos="0.0034259 0.032596 0.00055">
            <inertial pos="-0.00075094 0.0171062 0.00969512" mass="0.012001"
              fullinertia="2.38226e-06 4.86081e-07 2.42423e-06 -5.12168e-07 -4.23401e-08 -1.81793e-07"/>
            <joint name="right_pinky_dip" axis="0 0 -1" range="0 1.5593" class="finger_motor"/>
            <geom class="visual" material="body" mesh="pinky_2"/>
            <geom class="visual" material="pad" mesh="pinky_force_sensor_2" pos="0.0064512 0.027683 0.0061172" quat="0.689046258 0.081420444 0.702403669 -0.158792479"/>
            <geom class="visual" material="pad" mesh="pinky_force_sensor_3" pos="0.0063972 0.042707 0.0061154" quat="0.678772284 -0.28913267 0.645292608 0.198161388"/>
            <geom class="collision" mesh="pinky_2"/>
            <site name="pinky_force_sensor_2" class="pad" pos="0.00588693 0.0279344 0.00611312" quat="0.689046258 0.081420444 0.702403669 -0.158792479" size="0.0062161 0.0082349 0.004"/>
            <site name="pinky_force_sensor_3" class="pad" pos="0.00592275 0.0418775 0.00611315" quat="0.678772284 -0.28913267 0.645292608 0.198161388" size="0.0032366 0.0023286 0.004"/>
