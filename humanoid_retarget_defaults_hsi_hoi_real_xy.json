{
  "extends": "humanoid_retarget_defaults_hsi_hoi_standard.json",
  "solver": {
    "retarget_object_size": "real_xy",
    "scene_scale_anchor": "scene_centroid",
    "object_contact_map_cost": 10.0,
    "object_contact_map_samples": 4096,
    "object_contact_pair_latch": true,
    "object_contact_release_threshold_scale": 1.5,
    "object_contact_fade_frames": 5,
    "ground_contact_map_cost": 30.0,
    "trajectory_filter_acceleration_cost": 8.0,
    "trajectory_filter_jerk_cost": 2.0,
    "trajectory_filter_root_rotation": true,
    "trajectory_filter_reproject": true,
    "trajectory_filter_reproject_iters": 3,
    "trajectory_filter_reproject_tolerance": 0.002,
    "trajectory_filter_reproject_root_weight": 50.0,
    "robot_self_penetration_hard_constraint": true,
    "robot_self_penetration_hard_slack_cost": 5000.0,
    "trajectory_filter_reproject_smooth_cost": 1.0
  }
}
